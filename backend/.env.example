# Copiar a .env y reemplazar cada secreto. Nunca subir .env a Git.
NODE_ENV=development
HOST=127.0.0.1
USERS_PORT=4001
CATALOG_PORT=4002
ORDERS_PORT=4003
USERS_URL=http://127.0.0.1:4001
CATALOG_URL=http://127.0.0.1:4002
ORDERS_URL=http://127.0.0.1:4003
# Debe ser IDENTICA en los tres servicios; mínimo 32 caracteres aleatorios.
INTERNAL_SERVICE_KEY=REEMPLAZAR_POR_SECRETO_LARGO_ALEATORIO
SESSION_HOURS=8
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERS_USER=gb_usuarios
MYSQL_USERS_PASSWORD=REEMPLAZAR
MYSQL_CATALOG_USER=gb_catalogo
MYSQL_CATALOG_PASSWORD=REEMPLAZAR
MYSQL_ORDERS_USER=gb_pedidos
MYSQL_ORDERS_PASSWORD=REEMPLAZAR
# Solo para crear el primer administrador mediante script local, borrar al terminar.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA
