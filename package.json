{
  "name": "gourmet-bistro-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVICES,FRONTEND\" -c \"cyan,green\" \"npm run services\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/src/server.js",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "services": "concurrently -n \"USERS,CATALOG,ORDERS\" -c \"magenta,blue,yellow\" \"npm run services:users\" \"npm run services:catalog\" \"npm run services:orders\"",
    "services:users": "node backend/services/ms-usuarios/server.mjs",
    "services:catalog": "node backend/services/ms-catalogo/server.mjs",
    "services:orders": "node backend/services/ms-pedidos/server.mjs",
    "start:backend": "node backend/src/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "tsx --test src/domain/rules.test.ts",
    "test:services": "node --test backend/tests/*.test.mjs",
    "check:services": "node --check backend/services/ms-usuarios/server.mjs && node --check backend/services/ms-catalogo/server.mjs && node --check backend/services/ms-pedidos/server.mjs",
    "test:e2e": "node backend/tests/e2e.test.js",
    "lint": "tsc --noEmit",
    "db:migrate": "node database/migrate.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
